# HH Goa RAG — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Hugging Face token (required for gated datasets, optional for public ones)
HF_TOKEN=

# Model configuration
LLM_MODEL_ID=qwen/qwen3-4b-2507
LLM_QUANTIZATION=Q4_K_M
LLM_ENDPOINT=http://127.0.0.1:1234/v1

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval
RETRIEVAL_TOP_K=5
VECTOR_INDEX_PATH=indexes/vector.faiss
BM25_INDEX_PATH=indexes/bm25.pkl

# Latency thresholds (ms)
LATENCY_BUDGET_MS=200

# Speech-to-Text Configuration
STT_BACKEND=local
SARVAM_API_KEY=
